# Configuração pública da integração de encaminhamento iGreen.
IGREEN_BASE_URL=https://green.igreenenergy.com.br/
IGREEN_REFERRAL_ID=8963
IGREEN_SEND_CONTRACT=true

# Supabase TEST — valores reais devem existir apenas no ambiente server-side.
# Nunca prefixar a service role com NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin interno — credenciais reais devem permanecer somente server-side.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
